{
  "name": "chaos-button",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One button. Infinite bad decisions. A playful React + TypeScript chaos experience.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
